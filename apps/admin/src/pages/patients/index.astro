---
import AdminLayout from "../../layouts/AdminLayout.astro";
import PatientsScreen from "../../components/PatientsScreen.tsx";
import { listPatients } from "../../lib/api/patients.js";

const session = Astro.locals.session!;
const apiConfig = {
  baseUrl: import.meta.env.API_BASE_URL,
  tenantSlug: import.meta.env.TENANT_SLUG,
  accessToken: session.accessToken,
};
const patients = await listPatients(apiConfig);
---
<AdminLayout title="Patients">
  <PatientsScreen client:load apiConfig={apiConfig} patients={patients} />
</AdminLayout>
