# Same Dent Di Supabase project apps/api's dentdi tenant entry points at —
# only the anon key is needed here; this app never uses the service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=anon-key-here

# apps/api base URL and the X-Tenant-Slug this app always sends.
API_BASE_URL=http://localhost:8787
TENANT_SLUG=dentdi

# Playwright E2E credentials (e2e/helpers.ts, loaded via playwright.config.ts) —
# a real owner login for the live Dent Di project. Leave unset to skip the
# e2e suite entirely (specs test.skip rather than fail).
# E2E_OWNER_EMAIL=owner@example.com
# E2E_OWNER_PASSWORD=
