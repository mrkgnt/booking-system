# Per-tenant Supabase credentials. One block per client — see
# src/config/tenant-registry.ts for how these are consumed.
# Real values live in .env (git-ignored), never here.

DENTDI_SUPABASE_URL=https://your-project-ref.supabase.co
DENTDI_SUPABASE_SERVICE_ROLE_KEY=service-role-key-here
DENTDI_SUPABASE_ANON_KEY=anon-key-here

# App config
PORT=8787
NODE_ENV=development

# Bot protection (Cloudflare Turnstile) — disabled by default, no site key
# exists yet. Booking creation works fine locally without setting these.
TURNSTILE_ENABLED=false
# TURNSTILE_SECRET_KEY=

# Rate limiting on booking-creation endpoints (in-memory — see
# src/middleware/rate-limit.ts for why this is interim, not production-grade).
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Booking-creation tunables.
MIN_BOOKING_LEAD_MINUTES=60
VERIFICATION_TOKEN_TTL_MINUTES=30
