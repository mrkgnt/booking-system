---
import "../styles/global.css";
import { Button } from "@/components/ui/button";
import Footer from "@/components/Footer.astro";
import WhatsAppBubble from "@/components/WhatsAppBubble.astro";
import type { Locale, SiteCopy } from "@/content/types";
import { getFieldValueByKey, getSiteContent } from "@/lib/site-content";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  locale: Locale;
  copy: SiteCopy;
  title: string;
}

const { locale, copy, title } = Astro.props;

const localeLabels: Record<Locale, string> = { lv: "LV", ru: "RU", en: "EN" };
const otherLocales = (["lv", "ru", "en"] as const).filter((l) => l !== locale);

const widgetEmbedUrl = import.meta.env.WIDGET_EMBED_URL ?? "http://localhost:8082/embed.js";
const tenantSlug = import.meta.env.TENANT_SLUG ?? "dentdi";

// The floating WhatsApp bubble (issue #25) is sitewide chrome, not
// home-page content, so it's fetched here rather than in HomeContent.astro
// — both read quick_contact.whatsapp_url (always under the "home" page_slug,
// where issue #28 seeded it) so there's one source of truth for the value
// even though there are two independent fetches of it (one here for the
// bubble, one in HomeContent for the contact-card row); acceptable, since
// nothing about correctness depends on sharing the fetch itself.
const siteContent = await getSiteContent("home", locale);
const whatsappUrl = getFieldValueByKey(siteContent, "quick_contact", "whatsapp_url");
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Dent Di</title>
    <meta
      name="description"
      content="Dent Di — stomatoloģijas klīnika Rīgā kopš 2003. gada. Dental clinic in Riga since 2003."
    />
  </head>
  <body id="top" class="min-h-screen flex flex-col">
    <header class="border-b border-border/70 bg-background/95 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href={getRelativeLocaleUrl(locale, "/")} class="text-xl font-semibold tracking-tight text-primary">
          Dent Di
        </a>
        <nav class="hidden sm:flex items-center gap-6 text-sm text-foreground/80">
          <a href={getRelativeLocaleUrl(locale, "/")} class="hover:text-primary transition-colors">
            {copy.nav.home}
          </a>
          <a href={getRelativeLocaleUrl(locale, "/prices")} class="hover:text-primary transition-colors">
            {copy.nav.prices}
          </a>
        </nav>
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 text-xs text-muted-foreground">
            {otherLocales.map((l) => (
              <a href={getRelativeLocaleUrl(l, Astro.url.pathname.replace(/^\/(ru|en)/, "") || "/")} class="hover:text-primary transition-colors">
                {localeLabels[l]}
              </a>
            ))}
          </div>
          <Button data-platform-book size="sm" className="hover:bg-teal-dark">{copy.nav.bookNow}</Button>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <Footer copy={copy} />
    <WhatsAppBubble whatsappUrl={whatsappUrl} />

    <!--
      Embeds the Booking Widget (apps/widget, ADR-0004) rather than
      reimplementing booking-flow code. The default floating trigger is
      opted out via data-hide-default-button since the nav/hero already
      has a styled "Book Now" CTA (data-platform-book) for this Tenant.
    -->
    <script
      is:inline
      src={widgetEmbedUrl}
      async
      data-tenant={tenantSlug}
      data-locale={locale}
      data-hide-default-button
    ></script>
  </body>
</html>
