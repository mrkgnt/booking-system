---
// Testimonial card (issue #22, ADR-0005) — rendered by Hero.astro,
// positioned to overlap the hero photo per the reference design
// (https://dentdi-demo-price.sdentaldg.chatgpt.site/). Self-contained:
// fetches its own Site Content independently, so it (or its section_key)
// can be repositioned/reused later without touching Hero's own fetch.
import { getSectionContent, type SectionValues } from "@/lib/site-content";
import type { Locale } from "@/content/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const canonicalLocale = (import.meta.env.SITE_CONTENT_CANONICAL_LOCALE || "lv") as Locale;

const values: SectionValues = await getSectionContent(
  { supabaseUrl: import.meta.env.SUPABASE_URL, anonKey: import.meta.env.SUPABASE_ANON_KEY },
  "home",
  "testimonial",
  locale,
  canonicalLocale,
);
---

{
  values.quote && (
    <div class="absolute -bottom-6 left-4 right-4 sm:left-auto sm:right-8 sm:w-72 rounded-2xl bg-card p-5 shadow-xl border border-border/60">
      <p class="text-amber-500 text-sm leading-none" aria-hidden="true">★★★★★</p>
      <p class="mt-2 text-sm italic text-foreground/90 leading-relaxed">&ldquo;{values.quote}&rdquo;</p>
      {values.attribution && (
        <p class="mt-3 text-xs font-semibold text-muted-foreground not-italic">— {values.attribution}</p>
      )}
    </div>
  )
}
