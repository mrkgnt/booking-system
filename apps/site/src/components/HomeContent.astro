---
import { Button } from "@/components/ui/button";
import type { Locale, SiteCopy } from "@/content/types";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import Team from "@/components/Team.astro";
import Gallery from "@/components/Gallery.astro";

interface Props {
  copy: SiteCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

<!-- SECTION: hero (ticket #22, Site Content CMS, ADR-0005) -->
<Hero locale={locale} />

<!-- SECTION: about (ticket #22, Site Content CMS, ADR-0005) -->
<About locale={locale} />

<!-- SECTION: value_props/contact/find_us/footer (ticket #25) land below as
     their own insertion lines once built — everything from here down is
     still the pre-CMS hardcoded `copy`, untouched by this ticket. -->

{/* Team + Gallery (ticket #23) — reads apps/site/src/lib/team.ts +
    apps/site/src/lib/site-content.ts directly (staff table / gallery
    Site Content field), not `copy`. Self-contained components; this is
    the only block in this file ticket #23 touches — see Team.astro /
    Gallery.astro for the actual render logic. */}
<Team />
<Gallery />

<section class="mx-auto max-w-5xl px-4 sm:px-6 py-16 grid gap-10 sm:grid-cols-2">
  <div>
    <h2 class="text-2xl font-semibold text-primary mb-4">{copy.hours.heading}</h2>
    <ul class="divide-y divide-border/70 rounded-2xl border border-border/70 bg-card overflow-hidden">
      {copy.hours.rows.map((row) => (
        <li class="flex items-center justify-between px-4 py-2.5 text-sm">
          <span class="text-foreground/80">{row.day}</span>
          <span class="font-medium">{row.hours}</span>
        </li>
      ))}
    </ul>
  </div>
  <div id="contact">
    <h2 class="text-2xl font-semibold text-primary mb-4">{copy.contact.heading}</h2>
    <div class="rounded-2xl border border-border/70 bg-card p-6 space-y-3 text-sm">
      <p class="text-foreground/90">
        {copy.contact.addressLines.map((line) => <>{line}<br /></>)}
      </p>
      <p>
        <a href={`tel:${copy.contact.phone.replace(/\s+/g, "")}`} class="text-primary hover:underline">
          {copy.contact.phone}
        </a>
      </p>
      <p>
        <a href={`mailto:${copy.contact.email}`} class="text-primary hover:underline">
          {copy.contact.email}
        </a>
      </p>
      <Button data-platform-book variant="outline" className="mt-2">
        {copy.nav.bookNow}
      </Button>
    </div>
  </div>
</section>
