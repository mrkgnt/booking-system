---
import { Button } from "@/components/ui/button";
import FindUs from "@/components/FindUs.astro";
import QuickContact from "@/components/QuickContact.astro";
import ValueProps from "@/components/ValueProps.astro";
import type { Locale, SiteCopy } from "@/content/types";
import { getBusinessAddress, getFieldValueByKey, getFirstFieldValueByType, getSiteContent, parseLines } from "@/lib/site-content";

interface Props {
  copy: SiteCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;

const photoStrip = [
  "https://dentdi.lv/wp-content/uploads/2023/09/Dent_Di__11-min-2048x1365.jpg",
  "https://dentdi.lv/wp-content/uploads/2023/09/Dent_Di__24-min-2048x1365.jpg",
  "https://dentdi.lv/wp-content/uploads/2023/09/Dent_Di__6-min-2048x1365.jpg",
];

// Site Content fetch for this ticket's 3 sections (issue #25: value-props
// checklist, quick-contact card row, find-us band). Sibling tickets #22/#23
// add their own sections (hero/about/stats/testimonial, team/gallery) to
// this same page concurrently — if one of them lands a shared Site Content
// read helper when this merges, this call should be swapped to reuse it
// rather than keeping this one as a second, duplicate fetch.
const siteContent = await getSiteContent("home", locale);
const valuePropsItems = parseLines(getFirstFieldValueByType(siteContent, "value_props", "textarea"));
const whatsappUrl = getFieldValueByKey(siteContent, "quick_contact", "whatsapp_url");
const telegramUrl = getFieldValueByKey(siteContent, "quick_contact", "telegram_url");
const address = await getBusinessAddress();
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img
      src="https://dentdi.lv/wp-content/uploads/2023/10/Dent_Di__71-min-1-2048x1365-1.jpg"
      alt=""
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-background/85"></div>
  </div>
  <div class="relative mx-auto max-w-5xl px-4 sm:px-6 py-20 sm:py-28">
    <p class="text-sm uppercase tracking-wide text-primary font-medium mb-4">{copy.hero.since}</p>
    <h1 class="text-4xl sm:text-5xl font-semibold leading-tight text-foreground max-w-2xl">
      {copy.hero.title}
    </h1>
    <p class="mt-5 text-lg text-muted-foreground max-w-xl">{copy.hero.subtitle}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button data-platform-book size="lg" className="h-11 px-6 text-base rounded-full hover:bg-teal-dark">
        {copy.hero.cta}
      </Button>
      <a
        href={`tel:${copy.contact.phone.replace(/\s+/g, "")}`}
        class="text-foreground/80 hover:text-primary font-medium underline-offset-4 hover:underline"
      >
        {copy.hero.callUs} {copy.contact.phone}
      </a>
    </div>
  </div>
</section>

<section class="mx-auto max-w-5xl px-4 sm:px-6 py-16 grid gap-10 sm:grid-cols-[1.2fr_0.8fr]">
  <div>
    <h2 class="text-2xl font-semibold text-primary mb-4">{copy.about.heading}</h2>
    {copy.about.paragraphs.map((p) => (
      <p class="text-foreground/90 leading-relaxed mb-4">{p}</p>
    ))}
    <blockquote class="border-l-2 border-primary/40 pl-4 italic text-muted-foreground mt-6">
      {copy.about.quote.map((line) => <p class="mb-2">{line}</p>)}
      <p class="font-semibold text-foreground not-italic mt-2">— {copy.about.doctorName}</p>
    </blockquote>
  </div>
  <div class="grid grid-cols-3 gap-2 content-start">
    {photoStrip.map((src) => (
      <img src={src} alt="" class="aspect-square w-full object-cover rounded-xl" loading="lazy" />
    ))}
  </div>
</section>

<section class="mx-auto max-w-5xl px-4 sm:px-6 py-16">
  <div class="grid gap-6 sm:grid-cols-2">
    {copy.team.map((member) => (
      <div class="rounded-2xl border border-border/70 bg-card p-6">
        <p class="text-xl font-semibold text-foreground">{member.name}</p>
        <p class="text-primary font-medium mt-0.5">{member.role}</p>
        <p class="text-sm text-muted-foreground mt-2">{member.credential}</p>
      </div>
    ))}
  </div>
</section>

<ValueProps items={valuePropsItems} />

<section class="mx-auto max-w-5xl px-4 sm:px-6 py-16 grid gap-10 sm:grid-cols-2">
  <div>
    <h2 class="text-2xl font-semibold text-primary mb-4">{copy.hours.heading}</h2>
    <ul class="divide-y divide-border/70 rounded-2xl border border-border/70 bg-card overflow-hidden">
      {copy.hours.rows.map((row) => (
        <li class="flex items-center justify-between px-4 py-2.5 text-sm">
          <span class="text-foreground/80">{row.day}</span>
          <span class="font-medium">{row.hours}</span>
        </li>
      ))}
    </ul>
  </div>
  <div id="contact">
    <h2 class="text-2xl font-semibold text-primary mb-4">{copy.contact.heading}</h2>
    <div class="rounded-2xl border border-border/70 bg-card p-6 space-y-3 text-sm">
      <p class="text-foreground/90">
        {copy.contact.addressLines.map((line) => <>{line}<br /></>)}
      </p>
      <p>
        <a href={`tel:${copy.contact.phone.replace(/\s+/g, "")}`} class="text-primary hover:underline">
          {copy.contact.phone}
        </a>
      </p>
      <p>
        <a href={`mailto:${copy.contact.email}`} class="text-primary hover:underline">
          {copy.contact.email}
        </a>
      </p>
      <QuickContact whatsappUrl={whatsappUrl} telegramUrl={telegramUrl} />
      <Button data-platform-book variant="outline" className="mt-2">
        {copy.nav.bookNow}
      </Button>
    </div>
  </div>
</section>

<FindUs address={address} heading={copy.findUs.heading} mapsLabel={copy.findUs.mapsLabel} wazeLabel={copy.findUs.wazeLabel} />
