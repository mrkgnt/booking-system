---
import { MessageCircleIcon } from "lucide-react";

// Floating WhatsApp bubble (fixed position, issue #25) — reads the SAME
// `quick_contact.whatsapp_url` Site Content value QuickContact.astro's
// contact-card row renders; the caller (SiteLayout.astro) fetches it once
// and passes the resolved string to both, so there's one source of truth.
// Renders nothing when blank, rather than a dead floating button. Sitewide
// (mounted in SiteLayout, not HomeContent) since quick_contact's own Site
// Content row lives under the "home" page_slug but the bubble itself is
// chrome that should follow the visitor across apps/site's pages.
interface Props {
  whatsappUrl: string;
}

const { whatsappUrl } = Astro.props;
---

{whatsappUrl && (
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="WhatsApp"
    class="fixed bottom-5 right-5 z-50 flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105"
  >
    <MessageCircleIcon className="size-7" />
  </a>
)}
