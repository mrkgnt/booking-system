---
import { getSupabaseAnonClient } from "@/lib/supabase";
import { fetchGalleryImageUrls } from "@/lib/site-content";

// Self-contained, same rationale as Team.astro — no props, reads the
// gallery Site Content field (home/gallery/image_urls, ADR-0005) directly.
// The field is localized: false, so this always reads under the Tenant's
// canonical default locale, never the page's current locale.
const DEFAULT_LOCALE = "lv";
const PAGE_SLUG = "home";
const locale = Astro.currentLocale ?? DEFAULT_LOCALE;

const HEADINGS: Record<string, string> = {
  lv: "Galerija",
  ru: "Галерея",
  en: "Gallery",
};
const heading = HEADINGS[locale] ?? HEADINGS[DEFAULT_LOCALE];

const supabase = getSupabaseAnonClient();
const imageUrls = await fetchGalleryImageUrls(supabase, PAGE_SLUG, DEFAULT_LOCALE);
---

{
  imageUrls.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 sm:px-6 py-16">
      <h2 class="text-2xl font-semibold text-primary mb-8">{heading}</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {imageUrls.map((url) => (
          <img src={url} alt="" class="aspect-square w-full object-cover rounded-xl" loading="lazy" />
        ))}
      </div>
    </section>
  )
}
