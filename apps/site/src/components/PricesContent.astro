---
import type { SiteCopy } from "@/content/types";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 sm:px-6 py-16">
  <h1 class="text-3xl sm:text-4xl font-semibold text-primary mb-3">{copy.pricesPage.title}</h1>
  <p class="text-muted-foreground max-w-2xl mb-10">{copy.pricesPage.intro}</p>

  <div class="grid gap-6 sm:grid-cols-2">
    {copy.pricesPage.categories.map((category) => (
      <div class="rounded-2xl border border-border/70 bg-card p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">{category.name}</h2>
        <ul class="divide-y divide-border/70">
          {category.items.map((item) => (
            <li class="flex items-start justify-between gap-4 py-2.5 text-sm">
              <span class="text-foreground/85">{item.label}</span>
              <span class="font-medium whitespace-nowrap text-primary">{item.price}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <p class="text-sm text-muted-foreground mt-10">{copy.pricesPage.note}</p>
</section>
