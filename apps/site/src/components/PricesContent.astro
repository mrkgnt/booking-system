---
import type { SiteCopy } from "@/content/types";
import type { Catalog } from "@/lib/catalog/fetch";
import PriceList from "@/components/PriceList";

interface Props {
  copy: SiteCopy;
  catalog: Catalog | null;
}

const { copy, catalog } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 sm:px-6 py-16">
  <h1 class="text-3xl sm:text-4xl font-semibold text-primary mb-3">{copy.pricesPage.title}</h1>
  <p class="text-muted-foreground max-w-2xl mb-10">{copy.pricesPage.intro}</p>

  {catalog ? (
    <PriceList
      client:load
      categories={catalog.categories}
      services={catalog.services}
      allCategoriesLabel={copy.pricesPage.allCategoriesLabel}
      searchPlaceholder={copy.pricesPage.searchPlaceholder}
      noResultsLabel={copy.pricesPage.noResultsLabel}
      fromPricePrefix={copy.pricesPage.fromPricePrefix}
      upToPricePrefix={copy.pricesPage.upToPricePrefix}
    />
  ) : (
    <p class="text-muted-foreground">{copy.pricesPage.unavailableLabel}</p>
  )}

  <p class="text-sm text-muted-foreground mt-10">{copy.pricesPage.note}</p>
</section>
