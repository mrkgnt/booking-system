# The Booking Widget deployment this site embeds (ADR-0004) — in dev,
# apps/widget runs on :8082 (see apps/widget/astro.config.mjs).
WIDGET_EMBED_URL=http://localhost:8082/embed.js

# data-tenant value passed to embed.js.
TENANT_SLUG=dentdi

# Same Dent Di Supabase project apps/admin's .env.example points at — only
# the anon key is needed: apps/site reads service_categories/services/
# staff/translations/site_sections/site_content/business_profile.address
# directly via Supabase REST (no apps/api round trip), the same
# scoped-GRANT+RLS public-catalog-read pattern apps/admin/apps/widget
# already use (see db/tenant-schema.sql's "PUBLIC CATALOG READ ACCESS"
# section). Four features use this: the price-list section (issue #24,
# service_categories/services/translations), Team/Gallery (issue #23,
# staff/translations), the Site Content CMS (issue #22/ADR-0005,
# site_sections/site_content), and the "find us" band (issue #25,
# business_profile.address — a scoped anon GRANT added specifically for
# this, so apps/site never needs the service-role key for anything).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=anon-key-here

# The canonical/default locale for this Tenant, used to resolve a Site
# Content `localized: false` field (images, contact links — entered
# once, reused across every locale, ADR-0005) and as the fallback locale
# when a requested locale has no site_content row yet. Mirrors this
# Tenant's business_profile.default_locale — kept as a build-time var
# here rather than read live, since the anon key has no read grant on
# business_profile.default_locale and this value only changes at
# onboarding.
SITE_CONTENT_CANONICAL_LOCALE=lv
