# The Booking Widget deployment this site embeds (ADR-0004) — in dev,
# apps/widget runs on :8082 (see apps/widget/astro.config.mjs).
WIDGET_EMBED_URL=http://localhost:8082/embed.js

# data-tenant value passed to embed.js.
TENANT_SLUG=dentdi

# Same Dent Di Supabase project apps/admin's .env.example points at — only
# the anon key is needed: the price-list section (issue #24) reads
# service_categories/services/translations directly via Supabase REST,
# the same scoped-GRANT+RLS public-catalog-read pattern apps/admin/
# apps/widget already use (see db/tenant-schema.sql's "PUBLIC CATALOG
# READ ACCESS" section). apps/site never uses the service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=anon-key-here
