# The Booking Widget deployment this site embeds (ADR-0004) — in dev,
# apps/widget runs on :8082 (see apps/widget/astro.config.mjs).
WIDGET_EMBED_URL=http://localhost:8082/embed.js

# data-tenant value passed to embed.js.
TENANT_SLUG=dentdi

# Site Content CMS (ADR-0005, issue #22): apps/site reads site_sections/
# site_content directly via Supabase REST with the anon key — same
# "Public catalog reads" pattern apps/widget/apps/admin already use, not
# proxied through apps/api. apps/site is a per-Tenant deployment with its
# own project credentials (unlike the shared, credential-less apps/widget).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=anon-key-here

# The canonical/default locale for this Tenant, used to resolve a
# `localized: false` Site Content field (images, contact links — entered
# once, reused across every locale, ADR-0005) and as the fallback locale
# when a requested locale has no site_content row yet. Mirrors this
# Tenant's business_profile.default_locale — kept as a build-time var
# here rather than read live, since the anon key has no read grant on
# business_profile and this value only changes at onboarding.
SITE_CONTENT_CANONICAL_LOCALE=lv
