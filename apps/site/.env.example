# The Booking Widget deployment this site embeds (ADR-0004) — in dev,
# apps/widget runs on :8082 (see apps/widget/astro.config.mjs).
WIDGET_EMBED_URL=http://localhost:8082/embed.js

# data-tenant value passed to embed.js.
TENANT_SLUG=dentdi

# Same Dent Di Supabase project apps/admin's dentdi tenant entry points
# at — only the anon key is needed here; this app never uses the
# service-role key. Used for apps/site's direct public reads (staff,
# site_sections/site_content) — ADR-0005.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=anon-key-here
