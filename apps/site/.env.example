# The Booking Widget deployment this site embeds (ADR-0004) — in dev,
# apps/widget runs on :8082 (see apps/widget/astro.config.mjs).
WIDGET_EMBED_URL=http://localhost:8082/embed.js

# data-tenant value passed to embed.js.
TENANT_SLUG=dentdi

# Dent Di's Supabase project (same one apps/api/apps/admin point at) — used
# server-side only (Astro SSR frontmatter, never shipped to the browser) to
# read the Site Content CMS (ADR-0005) and business_profile.address for the
# "find us" band. Uses the SECRET (service-role) key, not the anon key:
# apps/site has no logged-in-staff session to scope RLS to the way
# apps/admin does, and business_profile itself has no `anon` GRANT in
# db/tenant-schema.sql — see src/lib/supabase.ts for the full rationale,
# flagged there as an open decision (ADR-0005 left "anon vs. secret key for
# apps/site's own reads" unsettled).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=service-role-key-here
