{
  "name": "@booking-system/widget",
  "private": true,
  "type": "module",
  "description": "Embeddable Booking Widget (ADR-0004) — one shared deployment across every Tenant, serving embed.js and the iframe drawer. Holds no Supabase credentials; talks only to apps/api's public endpoints.",
