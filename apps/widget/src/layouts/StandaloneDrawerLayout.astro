---
import "../styles/global.css";

// Issue #16/#17 — the Drawer's shared visual shell, recreated as a
// standalone page's own top-level content rather than injected into a
// host page by embed.js (there IS no host page here: these pages are
// reached directly via the reschedule/cancel link in a confirmation
// email, a direct top-level navigation, not an iframe embed — see
// ADR-0004's "Revised" note on the Transactional pages decision). Mirrors
// embed.js's own panel/backdrop CSS values (35vw right-aligned panel,
// dimmed background, full-screen takeover below the 768px breakpoint)
// for visual consistency with the embedded case, per that same decision.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="h-full min-h-screen bg-background text-foreground">
    <!--
      Mirrors embed.js's panel/backdrop look via Tailwind design-token
      classes instead of hand-rolled hex/rgba CSS: `bg-background` is the
      same token every other layout in this app uses (see
      DrawerLayout.astro's body class); `bg-black/40` for the dimmed
      backdrop matches shadcn/ui's own Dialog/Sheet overlay convention
      (bg-black/<alpha>), not a magic value. Breakpoint is Tailwind's
      built-in `md` (min-width: 768px), matching embed.js's own
      `@media (max-width: 767px)` cutoff — mobile-first here means the
      base (unprefixed) classes are the <768px look (full-screen,
      transparent backdrop) and `md:` overrides apply at/above 768px
      (35vw side panel, dimmed backdrop).
    -->
    <div class="fixed inset-0 flex justify-end bg-transparent md:bg-black/40">
      <div class="flex h-full w-full flex-col overflow-y-auto bg-background shadow-[-8px_0_24px_rgba(0,0,0,0.2)] md:w-[35vw]">
        <slot />
      </div>
    </div>
  </body>
</html>
