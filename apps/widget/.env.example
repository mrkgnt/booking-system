# apps/api base URL — build-time, shared by every tenant. The tenant
# slug itself is NOT configured here: it flows at runtime from the embed
# snippet's data-tenant attribute (see public/embed.js), through the
# browser-side fetch, as the X-Tenant-Slug header — never a build-time var.
# apps/api's documented default port is 8787 (see apps/api/.env.example),
# but check apps/api/.env's actual PORT value in your own environment —
# this dev environment happens to run apps/api on 8081 instead, which is
# also why apps/widget's own dev port is 8082, not 8081.
API_BASE_URL=http://localhost:8787

# Playwright E2E — no credentials needed (these routes are public/
# unauthenticated). Leave unset to still run the suite; it exercises the
# live Dent Di project directly through apps/api's public routes.
